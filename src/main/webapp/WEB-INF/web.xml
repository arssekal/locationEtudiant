<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
    	version="4.0">

    <display-name>locationEtudiant</display-name>
<!--    <welcome-file-list>-->
<!--        <welcome-file>utilisateur/login</welcome-file>-->
<!--    </welcome-file-list>-->


    <servlet>
        <servlet-name>verifier-code</servlet-name>
        <servlet-class>controller.VerifierCodeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>verifier-code</servlet-name>
        <url-pattern>/verification</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>utilisateur</servlet-name>
        <servlet-class>controller.UtilisateurServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>utilisateur</servlet-name>
        <url-pattern>/utilisateur/*</url-pattern>
    </servlet-mapping>


    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/erreurs.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/jsp/erreurs.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/WEB-INF/jsp/erreurs.jsp</location>
    </error-page>
</web-app>